@model VehicleContractSystem_Final.Models.BlockedVehicle
@{
    ViewData["Title"] = "إضافة مركبة ممنوعة";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-shield-exclamation"></i> إضافة مركبة إلى قائمة المنع</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ChassisNumber" class="form-label"></label>
                            <input asp-for="ChassisNumber" class="form-control" />
                            <span asp-validation-for="ChassisNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LicenseNumber" class="form-label"></label>
                            <input asp-for="LicenseNumber" class="form-control" />
                            <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PlateCode" class="form-label"></label>
                            <input asp-for="PlateCode" class="form-control" />
                            <span asp-validation-for="PlateCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label"></label>
                            <input asp-for="Source" class="form-control" placeholder="إدخال يدوي / جهة رسمية / مصدر خارجي" />
                            <span asp-validation-for="Source" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Reason" class="form-label"></label>
                            <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-3 mb-0">
                        يجب إدخال رقم الشاصي أو رقم المركبة على الأقل. هذا السجل يمنع إنشاء عقود جديدة للمركبة طالما أنه نشط.
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">رجوع</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-save"></i> حفظ المنع
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
