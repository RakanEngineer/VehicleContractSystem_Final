@model IEnumerable<VehicleContractSystem_Final.Models.AuditLog>
@{
    ViewData["Title"] = "سجل التدقيق";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">سجل التدقيق</h2>
        <p class="text-muted mb-0">متابعة آخر العمليات الحساسة داخل النظام.</p>
    </div>
    <span class="badge bg-primary fs-6">مدير النظام فقط</span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">المستخدم</label>
                <input name="user" value="@ViewBag.UserFilter" class="form-control" placeholder="اسم أو معرف المستخدم" />
            </div>
            <div class="col-md-2">
                <label class="form-label">الإجراء</label>
                <input name="action" value="@ViewBag.ActionFilter" class="form-control" placeholder="مثال: إنشاء عقد" />
            </div>
            <div class="col-md-2">
                <label class="form-label">نوع الكيان</label>
                <input name="entityType" value="@ViewBag.EntityTypeFilter" class="form-control" placeholder="Contract" />
            </div>
            <div class="col-md-2">
                <label class="form-label">من تاريخ</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">إلى تاريخ</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-dark text-white">
        <i class="bi bi-clipboard-data"></i> أحدث السجلات
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>التاريخ</th>
                        <th>المستخدم</th>
                        <th>الإجراء</th>
                        <th>الكيان</th>
                        <th>المعرف</th>
                        <th>الوصف</th>
                        <th>عنوان IP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">لا توجد سجلات مطابقة</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@log.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    <div class="fw-bold">@log.UserName</div>
                                    <small class="text-muted">@log.UserId</small>
                                </td>
                                <td><span class="badge bg-secondary">@log.Action</span></td>
                                <td>@log.EntityType</td>
                                <td>@log.EntityId</td>
                                <td>@log.Description</td>
                                <td class="text-nowrap">@log.IpAddress</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
