@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="container" dir="rtl">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
                    </div>

                    <h2 class="text-danger mb-3">خطأ</h2>

                    <p class="text-muted mb-4">
                        حدث خطأ أثناء معالجة الطلب
                    </p>

                    @if (Model?.ShowRequestId ?? false)
                    {
                        <div class="alert alert-light">
                            <small class="text-muted">
                                <strong>رقم الطلب:</strong> @Model?.RequestId
                            </small>
                        </div>
                    }

                    <div class="d-flex gap-2 justify-content-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> الرئيسية
                        </a>
                        <a href="javascript:history.back()" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> رجوع
                        </a>
                        <a href="javascript:location.reload()" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-clockwise"></i> إعادة المحاولة
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h6 class="card-title">ماذا يمكنك أن تفعل؟</h6>
                    <ul class="mb-0">
                        <li>تحقق من الاتصال</li>
                        <li>قم بتحديث الصفحة</li>
                        <li>حاول مرة أخرى لاحقاً</li>
                        <li>تواصل مع الدعم الفني</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto redirect to home after 30 seconds
        setTimeout(function() {
            if (confirm('هل تريد العودة إلى الصفحة الرئيسية؟')) {
                window.location.href = '@Url.Action("Index", "Home")';
            }
        }, 30000);
    </script>
}


