@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "استعادة كلمة المرور";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-envelope-lock text-primary" style="font-size: 3rem;"></i>
                    <h3 class="mt-3">استعادة كلمة المرور</h3>
                    <p class="text-muted">أدخل بريدك الإلكتروني لإرسال رابط إعادة التعيين</p>
                </div>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        <i class="bi bi-send"></i> إرسال رابط الاستعادة
                    </button>
                </form>

                <div class="text-center">
                    <a asp-action="Login">العودة إلى تسجيل الدخول</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
