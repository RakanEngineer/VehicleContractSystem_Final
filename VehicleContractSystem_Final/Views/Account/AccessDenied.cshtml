@inject IStringLocalizer<VehicleContractSystem_Final.Resources.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["AccessDenied"];
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="container" dir=@(isRtl ? "rtl" : "ltr")>
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-exclamation text-danger" style="font-size: 5rem;"></i>
                    </div>

                    <h2 class="text-danger mb-3">@Localizer["AccessDenied"]</h2>

                    <p class="text-muted mb-4">
                        @Localizer["AccessDeniedMessage"]
                    </p>

                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-info-circle"></i>
                        @Localizer["NoPermissionMessage"]
                    </div>

                    <div class="d-flex gap-2 justify-content-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> @Localizer["Home"]
                        </a>
                        <a href="javascript:history.back()" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> @Localizer["Back"]
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h6 class="card-title">@Localizer["NeedHelp"]</h6>
                    <p class="card-text small text-muted">
                        @Localizer["ContactAdminMessage"]
                    </p>
                    <a href="mailto:admin@vehiclecontract.com" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-envelope"></i> @Localizer["ContactSupport"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
