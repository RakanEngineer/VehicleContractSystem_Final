@{
    ViewData["Title"] = "تم رفض الوصول";
}

<div class="container" dir="rtl">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-exclamation text-danger" style="font-size: 5rem;"></i>
                    </div>

                    <h2 class="text-danger mb-3">تم رفض الوصول</h2>

                    <p class="text-muted mb-4">
                        ليس لديك صلاحية للوصول إلى هذه الصفحة
                    </p>

                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-info-circle"></i>
                        لا تملك الصلاحية المطلوبة
                    </div>

                    <div class="d-flex gap-2 justify-content-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> الرئيسية
                        </a>
                        <a href="javascript:history.back()" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> رجوع
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h6 class="card-title">هل تحتاج مساعدة؟</h6>
                    <p class="card-text small text-muted">
                        يرجى التواصل مع مدير النظام
                    </p>
                    <a href="mailto:admin@vehiclecontract.com" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-envelope"></i> تواصل مع الدعم الفني
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

