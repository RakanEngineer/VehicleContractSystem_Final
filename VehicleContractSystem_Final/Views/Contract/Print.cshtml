@model VehicleContractSystem_Final.Models.Contract
@{
    ViewData["Title"] = "طباعة العقد";
    Layout = null;

    var qrCodeBase64 = ViewBag.QRCodeBase64 as string;
    var verificationUrl = ViewBag.VerificationUrl as string;
    var officeName = string.IsNullOrWhiteSpace(Model.Office?.Name) ? "نظام إدارة عقود المركبات" : Model.Office.Name;
    var officeLicense = string.IsNullOrWhiteSpace(Model.Office?.LicenseNumber) ? "غير محدد" : Model.Office.LicenseNumber;
    var officeAddress = string.IsNullOrWhiteSpace(Model.Office?.Address) ? "غير محدد" : Model.Office.Address;
    var officePhone = string.IsNullOrWhiteSpace(Model.Office?.Phone) ? "غير محدد" : Model.Office.Phone;

    var vehicleTypeName = string.IsNullOrWhiteSpace(Model.VehicleTypeNameSnapshot) ? Model.VehicleCategory : Model.VehicleTypeNameSnapshot;
    var vehicleModelName = string.IsNullOrWhiteSpace(Model.VehicleModelNameSnapshot) ? Model.VehicleModel : Model.VehicleModelNameSnapshot;
    var vehicleColorName = string.IsNullOrWhiteSpace(Model.VehicleColorNameSnapshot) ? Model.VehicleColor : Model.VehicleColorNameSnapshot;
    var licenseNumber = string.IsNullOrWhiteSpace(Model.LicenseNumberSnapshot) ? Model.LicenseNumber : Model.LicenseNumberSnapshot;
    var chassisNumber = string.IsNullOrWhiteSpace(Model.ChassisNumberSnapshot) ? Model.ChassisNumber : Model.ChassisNumberSnapshot;
    var manufactureYear = Model.ManufactureYearSnapshot ?? Model.ManufactureYear;
    var vehicleProvinceName = Model.Province?.NameAr;
    vehicleProvinceName = vehicleProvinceName == "كربلاء" ? "كربلاء المقدسة" : vehicleProvinceName;
    vehicleProvinceName = vehicleProvinceName == "النجف" ? "النجف الأشرف" : vehicleProvinceName;
    var contractStatus = Model.Status == VehicleContractSystem_Final.Enums.ContractStatus.Open ? "مفتوح" : "مغلق";
}

@functions {
    private static string ValueOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string Money(decimal value) =>
        $"${value:N0}";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Model.ContractNumber</title>
    <style>
        @@page {
            size: A4 portrait;
            margin: 10mm;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            direction: rtl;
            font-family: "Cairo", "Tajawal", Tahoma, sans-serif;
            background: #eef5f8;
            color: #15222f;
            font-size: 10.4px;
            line-height: 1.32;
        }

        .print-toolbar {
            width: 210mm;
            margin: 12px auto 8px;
            display: flex;
            gap: 8px;
        }

        .print-toolbar button,
        .print-toolbar a {
            border: 0;
            border-radius: 4px;
            padding: 8px 14px;
            font: inherit;
            cursor: pointer;
            text-decoration: none;
        }

        .print-toolbar button {
            background: #0f5f7f;
            color: #fff;
        }

        .print-toolbar a {
            background: #7a5a19;
            color: #fff;
        }

        .sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 16px;
            padding: 10mm;
            background: #fff;
            box-shadow: 0 10px 26px rgba(0, 0, 0, .08);
        }

        .contract {
            min-height: 277mm;
            max-height: 277mm;
            border: 2.2px solid #0f5f7f;
            padding: 6mm;
            overflow: hidden;
            position: relative;
            background:
                linear-gradient(180deg, rgba(15, 95, 127, .05), rgba(255, 255, 255, 0) 45mm),
                #ffffff;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .contract::before {
            content: "";
            position: absolute;
            inset: 3mm;
            border: 1px solid #d8aa3f;
            pointer-events: none;
            z-index: 1;
        }

        .watermark-image {
            position: absolute;
            inset: 0;
            z-index: 3;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
            opacity: .09;
            mix-blend-mode: multiply;
        }

        .watermark-image img {
            width: 150mm;
            max-width: 78%;
            height: auto;
            display: block;
            filter: grayscale(1) contrast(1.04);
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            min-height: 263mm;
            gap: 4px;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .header {
            display: grid;
            grid-template-columns: 1fr 1.25fr 28mm;
            gap: 7px;
            align-items: stretch;
            border-bottom: 2px solid #d8aa3f;
            padding-bottom: 5px;
        }

        .office-box,
        .meta-box,
        .qr-box {
            border: 1px solid #8bc0d0;
            padding: 4px 6px;
            background: #f2fbfd;
        }

        .office-box {
            position: relative;
            overflow: hidden;
        }

        .office-box::before {
            content: "";
            position: absolute;
            inset: 1px;
            background-image: url('@Url.Content("~/images/bmw-watermark.png?v=20260814")');
            background-repeat: no-repeat;
            background-position: center;
            background-size: 95%;
            opacity: .14;
            filter: grayscale(1) contrast(1.05);
            mix-blend-mode: multiply;
            pointer-events: none;
            z-index: 0;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .office-box > * {
            position: relative;
            z-index: 1;
        }

        .office-name {
            font-weight: 800;
            font-size: 13px;
            margin-bottom: 2px;
            color: #0f5f7f;
        }

        .title-box {
            text-align: center;
            padding-top: 2px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 900;
            color: #12385a;
        }

        .title-box .sub {
            display: inline-block;
            margin-top: 3px;
            padding: 2px 12px;
            border: 1px solid #d8aa3f;
            border-radius: 999px;
            font-size: 10px;
            background: #fff5d6;
            color: #6f4e08;
        }

        .title-box .legal-identity {
            margin-top: 3px;
            font-size: 9.2px;
            font-weight: 800;
            color: #0f5f7f;
        }

        .meta-line {
            display: flex;
            justify-content: space-between;
            gap: 6px;
            border-bottom: 1px dotted #6aa8bd;
            padding: 1px 0;
        }

        .qr-box {
            text-align: center;
            font-size: 8.8px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 2px;
        }

        .qr-box strong {
            font-size: 9.4px;
            line-height: 1.1;
            color: #12385a;
        }

        .qr-box .qr-chassis {
            max-width: 25mm;
            font-size: 8.4px;
            font-weight: 800;
            line-height: 1.15;
            word-break: break-all;
        }

        .qr-box img {
            width: 20mm;
            height: 20mm;
            display: block;
        }

        .intro {
            border: 1px solid #8bc0d0;
            padding: 4px 6px;
            background: #f5fbfd;
            text-align: justify;
            font-size: 10px;
        }

        .section {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .section-title {
            background: #0f5f7f;
            color: #fff;
            font-weight: 800;
            padding: 2px 7px;
            margin: 2px 0 2px;
            border-radius: 2px;
            font-size: 10.8px;
        }

        .two-col .section:first-child .section-title {
            background: #175b43;
        }

        .two-col .section:last-child .section-title {
            background: #734c9a;
        }

        .vehicle-table + .section-title,
        .section:nth-of-type(2) .section-title {
            background: #0f5f7f;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th,
        td {
            border: 1px solid #a8c9d4;
            padding: 2.6px 4px;
            vertical-align: top;
            word-break: break-word;
        }

        th {
            width: 23%;
            background: #e8f5f8;
            font-weight: 800;
            color: #12385a;
            white-space: nowrap;
        }

        td {
            background: #ffffff;
        }

        .vehicle-table th,
        .finance-table th {
            width: 16%;
        }

        .finance-table td {
            text-align: center;
            font-weight: 800;
            background: #fffaf0;
        }

        .remaining {
            color: #b42318;
            background: #fff0ed !important;
        }

        .payment-method {
            color: #0f5f7f;
            background: #eaf8fb !important;
        }

        .chassis-number {
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 1px;
            color: #8c1d18;
            background: #fff1df;
            line-height: 1.15;
        }

        .clauses {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1px 10px;
            margin: 0;
            padding: 4px 18px 4px 4px;
            border: 1px solid #d8aa3f;
            background: #fff9e8;
            font-size: 9.35px;
        }

        .notes {
            min-height: 10mm;
            border: 1px solid #a8c9d4;
            padding: 4px 6px;
            white-space: pre-wrap;
            background: #f8fcfd;
        }

        .signatures {
            margin-top: auto;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 5px;
            padding-top: 4px;
        }

        .signature-box {
            height: 22mm;
            border: 1px solid #0f5f7f;
            background: linear-gradient(to top, #e8f5f8 0, #e8f5f8 17px, #fff 17px);
            display: flex;
            flex-direction: column;
            align-items: end;
            justify-content: center;
            padding: 3px 4px 4px;
            text-align: center;
            font-weight: 800;
            font-size: 9.5px;
        }

        .signature-label,
        .signature-name {
            width: 100%;
        }

        .signature-label {
            margin-top: auto;
            color: #12385a;
        }

        .signature-name {
            margin-top: 2px;
            font-size: 8.6px;
            font-weight: 700;
            color: #5d6a75;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .signature-stamp {
            width: 100%;
            margin-top: 4px;
            padding-top: 3px;
            border-top: 1px dashed #d8aa3f;
            font-size: 8.4px;
            color: #6f4e08;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .signature-stamp strong {
            display: block;
            margin-bottom: 2px;
            font-size: 8.8px;
            color: #8a5b0a;
        }

        .footer-note {
            margin-top: 4px;
            border-top: 1px solid #d8aa3f;
            padding-top: 3px;
            text-align: center;
            font-size: 8.8px;
            color: #40505c;
        }

        .page-number {
            text-align: center;
            font-size: 8.4px;
            font-weight: 800;
            color: #0f5f7f;
            margin-top: 2px;
        }

        .verification-note {
            border: 1px solid #8bc0d0;
            background: #effaff;
            padding: 3px 6px;
            font-size: 8.8px;
            color: #214356;
            text-align: center;
        }

        .verification-note span {
            display: block;
            direction: ltr;
            word-break: break-all;
        }

        @@media print {
            html,
            body {
                width: 210mm;
                height: 297mm;
                background: #fff;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .watermark-image {
                opacity: .09;
            }

            .no-print,
            nav,
            footer,
            .navbar,
            .footer,
            .btn,
            button {
                display: none !important;
            }

            .sheet {
                width: auto;
                min-height: auto;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }

            .contract {
                min-height: 277mm;
                max-height: 277mm;
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="print-toolbar no-print">
        <button type="button" onclick="window.print()">طباعة العقد</button>
        <a asp-action="Details" asp-route-id="@Model.Id">رجوع</a>
    </div>

    <main class="sheet" role="document" aria-label="عقد بيع وشراء مركبة">
        <section class="contract">
            <div class="watermark-image" aria-hidden="true">
                <img src="@Url.Content("~/images/bmw-watermark.png?v=20260814")" alt="" />
            </div>
            <div class="content">
                <header class="header">
                    <div class="office-box">
                        <div class="office-name">@officeName</div>
                        <div>رقم الإجازة: @officeLicense</div>
                        <div>العنوان: @officeAddress</div>
                        <div>الهاتف: @officePhone</div>
                    </div>

                    <div class="title-box">
                        <h1>عقد بيع وشراء مركبة</h1>
                        <div class="sub">وثيقة بيع منظمة من مكتب مجاز</div>
                        <div class="legal-identity">مجاز من مديرية المرور العامة</div>
                        <div class="meta-box" style="margin-top:4px">
                            <div class="meta-line"><span>رقم العقد</span><strong>@Model.ContractNumber</strong></div>
                            <div class="meta-line"><span>تاريخ العقد</span><strong>@Model.ContractDate.ToString("yyyy/MM/dd")</strong></div>
                            <div class="meta-line"><span>حالة العقد</span><strong>@contractStatus</strong></div>
                        </div>
                    </div>

                    <div class="qr-box">
                        @if (!string.IsNullOrWhiteSpace(qrCodeBase64))
                        {
                            <img src="data:image/png;base64,@qrCodeBase64" alt="رمز التحقق من العقد" />
                            <strong>@Model.ContractNumber</strong>
                            <span class="qr-chassis">@ValueOrDash(chassisNumber)</span>
                            <span>رابط التحقق</span>
                        }
                        else
                        {
                            <strong>رمز التحقق</strong>
                            <span>غير متوفر</span>
                        }
                    </div>
                </header>

                <div class="intro">
                    أقر الطرفان بكامل أهليتهما القانونية واتفقا على بيع وشراء المركبة المبينة أوصافها أدناه وفق البيانات والمبالغ والشروط الواردة في هذا العقد.
                </div>

                <div class="two-col">
                    <section class="section">
                        <div class="section-title">بيانات البائع</div>
                        <table>
                            <tbody>
                                <tr><th>الاسم</th><td>@Model.SellerName</td></tr>
                                <tr><th>رقم الهوية</th><td>@Model.SellerIdNumber</td></tr>
                                <tr><th>الهاتف</th><td>@Model.SellerPhone</td></tr>
                                <tr><th>العنوان</th><td>@ValueOrDash(Model.SellerAddress)</td></tr>
                                <tr><th>جهة الإصدار</th><td>@ValueOrDash(Model.SellerIdIssuer)</td></tr>
                            </tbody>
                        </table>
                    </section>

                    <section class="section">
                        <div class="section-title">بيانات المشتري</div>
                        <table>
                            <tbody>
                                <tr><th>الاسم</th><td>@Model.BuyerName</td></tr>
                                <tr><th>رقم الهوية</th><td>@Model.BuyerIdNumber</td></tr>
                                <tr><th>الهاتف</th><td>@Model.BuyerPhone</td></tr>
                                <tr><th>العنوان</th><td>@ValueOrDash(Model.BuyerAddress)</td></tr>
                                <tr><th>جهة الإصدار</th><td>@ValueOrDash(Model.BuyerIdIssuer)</td></tr>
                            </tbody>
                        </table>
                    </section>
                </div>

                <section class="section">
                    <div class="section-title">بيانات المركبة</div>
                    <table class="vehicle-table">
                        <tbody>
                            <tr>
                                <th>اسم المالك</th>
                                <td>@ValueOrDash(Model.CurrentOwnerName)</td>
                                <th>رقم المركبة</th>
                                <td>@ValueOrDash(licenseNumber)</td>
                            </tr>
                            <tr>
                                <th>محافظة المركبة</th>
                                <td>@ValueOrDash(vehicleProvinceName)</td>
                                <th>رقم السنوية</th>
                                <td>@ValueOrDash(Model.AnnualRegistrationNumber)</td>
                            </tr>
                            <tr>
                                <th>صنف المركبة</th>
                                <td>@ValueOrDash(vehicleTypeName)</td>
                                <th>سنة الصنع</th>
                                <td>@manufactureYear</td>
                            </tr>
                            <tr>
                                <th>رقم الشاصي</th>
                                <td class="chassis-number">@ValueOrDash(chassisNumber)</td>
                                <th>الماركة</th>
                                <td>@ValueOrDash(Model.VehicleBrand)</td>
                            </tr>
                            <tr>
                                <th>نوع المركبة</th>
                                <td>@ValueOrDash(vehicleModelName)</td>
                                <th>لون المركبة</th>
                                <td>@ValueOrDash(vehicleColorName)</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section class="section">
                    <div class="section-title">المعلومات المالية</div>
                    <table class="finance-table">
                        <tbody>
                            <tr>
                                <th>سعر المركبة</th>
                                <td>@Money(Model.VehiclePrice)</td>
                                <th>استلم البائع مبلغ وقدره</th>
                                <td>@Money(Model.PaidAmount)</td>
                                <th>المبلغ المتبقي</th>
                                <td class="remaining">@Money(Model.RemainingAmount)</td>
                            </tr>
                            <tr>
                                <th>طريقة الدفع</th>
                                <td class="payment-method" colspan="2">نقداً</td>
                                <th>حالة العقد</th>
                                <td colspan="2">@contractStatus</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section class="section">
                    <div class="section-title">الشروط القانونية</div>
                    <ol class="clauses">
                        <li>يقر الطرفان بصحة المعلومات الواردة في العقد.</li>
                        <li>يلتزم البائع بتحمل الغرامات والمخالفات السابقة لتاريخ العقد.</li>
                        <li>يلتزم المشتري بإكمال إجراءات نقل الملكية حسب التعليمات النافذة.</li>
                        <li>استلم المشتري المركبة بالحالة المبينة أعلاه وبعد المعاينة.</li>
                        <li>لا يجوز الحك أو الشطب أو التعديل على هذا العقد.</li>
                        <li>يعتبر هذا العقد ملزماً للطرفين بعد التوقيع عليه.</li>
                        <li>يتحمل الطرفان المسؤولية القانونية الكاملة عن صحة المستمسكات والبيانات المقدمة.</li>
                    </ol>
                </section>

                <section class="section">
                    <div class="section-title">الملاحظات</div>
                    <div class="notes">@ValueOrDash(Model.Notes)</div>
                </section>

                <div class="verification-note">
                    يمكن التحقق من صحة العقد عبر مسح رمز QR. أي اختلاف بين بيانات العقد ونتيجة التحقق يعد مؤشراً لمراجعة المكتب المنظم.
                    @if (!string.IsNullOrWhiteSpace(verificationUrl))
                    {
                        <span>@verificationUrl</span>
                    }
                </div>

                <section class="signatures">
                    <div class="signature-box">
                        <div class="signature-label">توقيع البائع</div>
                        <div class="signature-name">@ValueOrDash(Model.SellerName)</div>
                    </div>
                    <div class="signature-box">
                        <div class="signature-label">توقيع المشتري</div>
                        <div class="signature-name">@ValueOrDash(Model.BuyerName)</div>
                    </div>
                    <div class="signature-box">
                        <div class="signature-label">منظم العقد</div>
                        <div class="signature-name">@officeName</div>
                        <div class="signature-stamp">
                            <strong>الختم</strong>
                            @ValueOrDash(officeLicense)
                        </div>
                    </div>
                    <div class="signature-box">
                        <div class="signature-label">الشاهد</div>
                        <div class="signature-name">-</div>
                    </div>
                    <div class="signature-box">
                        <div class="signature-label">الشاهد</div>
                        <div class="signature-name">-</div>
                    </div>
                </section>

                <div class="footer-note">
                    حرر هذا العقد إلكترونياً، ويعد توقيع الأطراف وختم المكتب إقراراً بصحة البيانات والمبالغ والشروط المذكورة أعلاه.
                </div>
                <div class="page-number">صفحة 1 / 1</div>
            </div>
        </section>
    </main>
</body>
</html>
