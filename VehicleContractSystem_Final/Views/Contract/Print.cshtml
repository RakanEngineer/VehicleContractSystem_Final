@model VehicleContractSystem_Final.Models.Contract
@{
    ViewData["Title"] = "طباعة العقد";
    Layout = null;
    var qrCodeBase64 = ViewBag.QRCodeBase64 as string;
    var officeName = string.IsNullOrWhiteSpace(Model.Office?.Name) ? "نظام إدارة عقود المركبات" : Model.Office.Name;
    var officeLicense = string.IsNullOrWhiteSpace(Model.Office?.LicenseNumber) ? "غير محدد" : Model.Office.LicenseNumber;
    var officeAddress = string.IsNullOrWhiteSpace(Model.Office?.Address) ? "غير محدد" : Model.Office.Address;
}

@functions {
    private static string ValueOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string Money(decimal value) =>
        $"{value:N0} دينار";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Model.ContractNumber</title>
    <style>
        @@page {
            size: A4;
            margin: 10mm;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            direction: rtl;
            font-family: Arial, Tahoma, sans-serif;
            background: #eef1f4;
            color: #101418;
            font-size: 11px;
            line-height: 1.35;
        }

        .print-toolbar {
            width: 210mm;
            margin: 14px auto 8px;
            display: flex;
            gap: 8px;
            justify-content: flex-start;
        }

        .print-button,
        .back-link {
            border: 0;
            border-radius: 4px;
            padding: 8px 14px;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            font-family: inherit;
        }

        .print-button {
            background: #173f5f;
            color: #fff;
        }

        .back-link {
            background: #6c757d;
            color: #fff;
        }

        .sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 18px;
            padding: 10mm;
            background: #fff;
            border: 1px solid #d9dee4;
            box-shadow: 0 8px 28px rgba(16, 20, 24, .08);
            overflow: hidden;
        }

        .contract-frame {
            min-height: 277mm;
            border: 1.4px solid #111820;
            padding: 7mm;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .document-header {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 10px;
            align-items: start;
            border-bottom: 2px solid #111820;
            padding-bottom: 6px;
        }

        .office-block,
        .meta-block {
            font-size: 10.5px;
        }

        .office-name {
            font-weight: 800;
            font-size: 14px;
            margin-bottom: 3px;
        }

        .document-title {
            text-align: center;
        }

        .document-title h1 {
            margin: 0 0 4px;
            font-size: 20px;
            font-weight: 900;
            letter-spacing: 0;
        }

        .document-title .subtitle {
            border: 1px solid #111820;
            border-radius: 999px;
            padding: 2px 12px;
            font-size: 10.5px;
            display: inline-block;
        }

        .meta-block {
            justify-self: end;
            min-width: 42mm;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            border-bottom: 1px dotted #8b949e;
            padding: 1px 0;
        }

        .section {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .section-title {
            margin: 4px 0 3px;
            padding: 3px 7px;
            background: #111820;
            color: #fff;
            font-weight: 800;
            font-size: 11.5px;
            border-radius: 3px;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin: 0;
        }

        .info-table th,
        .info-table td {
            border: 1px solid #c8ced6;
            padding: 3px 5px;
            vertical-align: top;
            word-break: break-word;
        }

        .info-table th {
            width: 21%;
            background: #f3f5f7;
            color: #1d252d;
            font-weight: 800;
            white-space: nowrap;
        }

        .two-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }

        .statement {
            border: 1px solid #c8ced6;
            padding: 5px 7px;
            margin-top: 3px;
            text-align: justify;
            font-size: 10.5px;
            background: #fbfcfd;
        }

        .financial-table td,
        .financial-table th {
            text-align: center;
        }

        .financial-table .remaining {
            font-weight: 900;
            color: #8a1f11;
        }

        .notes-box {
            min-height: 17mm;
            border: 1px solid #c8ced6;
            padding: 5px 7px;
            white-space: pre-wrap;
            background: #fbfcfd;
        }

        .footer-area {
            margin-top: auto;
            padding-top: 5px;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .qr-and-signatures {
            display: grid;
            grid-template-columns: 26mm 1fr;
            gap: 8px;
            align-items: end;
        }

        .qr-box {
            width: 26mm;
            min-height: 26mm;
            border: 1px solid #c8ced6;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-size: 9px;
            color: #5b6670;
            padding: 2mm;
        }

        .qr-box img {
            width: 22mm;
            height: 22mm;
            display: block;
        }

        .signatures {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .signature-box {
            height: 22mm;
            border: 1px solid #111820;
            display: flex;
            align-items: end;
            justify-content: center;
            padding-bottom: 4px;
            font-weight: 800;
            background: linear-gradient(to top, #f7f8fa 0, #f7f8fa 18px, #fff 18px);
        }

        .legal-note {
            margin-top: 5px;
            padding-top: 4px;
            border-top: 1px solid #c8ced6;
            font-size: 9.5px;
            color: #3d464f;
            text-align: center;
        }

        @@media print {
            html,
            body {
                width: 210mm;
                height: 297mm;
                background: #fff;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .no-print,
            nav,
            footer,
            header,
            .navbar,
            .footer,
            .btn,
            button {
                display: none !important;
            }

            .sheet {
                width: auto;
                min-height: auto;
                margin: 0;
                padding: 0;
                border: 0;
                box-shadow: none;
            }

            .contract-frame {
                min-height: 277mm;
                max-height: 277mm;
                overflow: hidden;
            }

            .section,
            .document-header,
            .footer-area,
            table,
            tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="print-toolbar no-print">
        <button type="button" class="print-button" onclick="window.print()">طباعة العقد</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="back-link">رجوع</a>
    </div>

    <main class="sheet" role="document" aria-label="عقد بيع وشراء مركبة">
        <section class="contract-frame">
            <header class="document-header">
                <div class="office-block">
                    <div class="office-name">@officeName</div>
                    <div>رقم الإجازة: @officeLicense</div>
                    <div>العنوان: @officeAddress</div>
                    <div>الهاتف: @ValueOrDash(Model.Office?.Phone)</div>
                </div>

                <div class="document-title">
                    <h1>عقد بيع وشراء مركبة</h1>
                    <div class="subtitle">وثيقة رسمية صادرة من نظام إدارة عقود المركبات</div>
                </div>

                <div class="meta-block">
                    <div class="meta-row"><span>رقم العقد</span><strong>@Model.ContractNumber</strong></div>
                    <div class="meta-row"><span>تاريخ العقد</span><strong>@Model.ContractDate.ToString("yyyy/MM/dd")</strong></div>
                    <div class="meta-row"><span>حالة العقد</span><strong>@Model.Status</strong></div>
                    <div class="meta-row"><span>تاريخ الطباعة</span><strong>@DateTime.Now.ToString("yyyy/MM/dd")</strong></div>
                </div>
            </header>

            <div class="statement">
                أقر الطرفان بكامل أهليتهما القانونية على إبرام هذا العقد، واتفقا على بيع وشراء المركبة الموضحة بياناتها أدناه وفق المبالغ والشروط المذكورة في هذه الوثيقة.
            </div>

            <div class="two-columns">
                <section class="section">
                    <div class="section-title">بيانات البائع</div>
                    <table class="info-table">
                        <tbody>
                            <tr><th>الاسم</th><td>@Model.SellerName</td></tr>
                            <tr><th>رقم الهاتف</th><td>@Model.SellerPhone</td></tr>
                            <tr><th>رقم الهوية</th><td>@Model.SellerIdNumber</td></tr>
                            <tr><th>جهة الإصدار</th><td>@ValueOrDash(Model.SellerIdIssuer)</td></tr>
                            <tr><th>المهنة</th><td>@ValueOrDash(Model.SellerOccupation)</td></tr>
                            <tr><th>العنوان</th><td>@ValueOrDash(Model.SellerAddress)</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="section">
                    <div class="section-title">بيانات المشتري</div>
                    <table class="info-table">
                        <tbody>
                            <tr><th>الاسم</th><td>@Model.BuyerName</td></tr>
                            <tr><th>رقم الهاتف</th><td>@Model.BuyerPhone</td></tr>
                            <tr><th>رقم الهوية</th><td>@Model.BuyerIdNumber</td></tr>
                            <tr><th>جهة الإصدار</th><td>@ValueOrDash(Model.BuyerIdIssuer)</td></tr>
                            <tr><th>المهنة</th><td>@ValueOrDash(Model.BuyerOccupation)</td></tr>
                            <tr><th>العنوان</th><td>@ValueOrDash(Model.BuyerAddress)</td></tr>
                        </tbody>
                    </table>
                </section>
            </div>

            <section class="section">
                <div class="section-title">بيانات المركبة</div>
                <table class="info-table">
                    <tbody>
                        <tr>
                            <th>المالك الحالي</th>
                            <td>@Model.CurrentOwnerName</td>
                            <th>عنوان المالك</th>
                            <td>@ValueOrDash(Model.CurrentOwnerAddress)</td>
                        </tr>
                        <tr>
                            <th>الماركة</th>
                            <td>@Model.VehicleBrand</td>
                            <th>الموديل</th>
                            <td>@Model.VehicleModel</td>
                        </tr>
                        <tr>
                            <th>سنة الصنع</th>
                            <td>@Model.ManufactureYear</td>
                            <th>النوع</th>
                            <td>@ValueOrDash(Model.VehicleCategory)</td>
                        </tr>
                        <tr>
                            <th>اللون</th>
                            <td>@ValueOrDash(Model.VehicleColor)</td>
                            <th>رقم المركبة</th>
                            <td>@Model.LicenseNumber</td>
                        </tr>
                        <tr>
                            <th>رقم الشاصي</th>
                            <td>@Model.ChassisNumber</td>
                            <th>رقم السنوية</th>
                            <td>@ValueOrDash(Model.AnnualRegistrationNumber)</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="section">
                <div class="section-title">العنوان وموقع التسجيل</div>
                <table class="info-table">
                    <tbody>
                        <tr>
                            <th>المحافظة</th>
                            <td>@ValueOrDash(Model.Province?.NameAr)</td>
                            <th>المدينة</th>
                            <td>@ValueOrDash(Model.City?.NameAr)</td>
                        </tr>
                        <tr>
                            <th>المحلة</th>
                            <td>@ValueOrDash(Model.Neighborhood)</td>
                            <th>الزقاق / الدار</th>
                            <td>@ValueOrDash(Model.AlleyNumber) / @ValueOrDash(Model.HouseNumber)</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="section">
                <div class="section-title">المعلومات المالية</div>
                <table class="info-table financial-table">
                    <tbody>
                        <tr>
                            <th>سعر المركبة</th>
                            <td>@Money(Model.VehiclePrice)</td>
                            <th>المبلغ المدفوع</th>
                            <td>@Money(Model.PaidAmount)</td>
                            <th>المبلغ المتبقي</th>
                            <td class="remaining">@Money(Model.RemainingAmount)</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="section">
                <div class="section-title">الملاحظات</div>
                <div class="notes-box">@ValueOrDash(Model.Notes)</div>
            </section>

            <footer class="footer-area">
                <div class="qr-and-signatures">
                    <div class="qr-box">
                        @if (!string.IsNullOrWhiteSpace(qrCodeBase64))
                        {
                            <img src="data:image/png;base64,@qrCodeBase64" alt="رمز التحقق من العقد" />
                        }
                        else
                        {
                            <span>رمز التحقق غير متوفر</span>
                        }
                    </div>

                    <div class="signatures">
                        <div class="signature-box">توقيع البائع</div>
                        <div class="signature-box">توقيع المشتري</div>
                        <div class="signature-box">ختم وتوقيع المكتب</div>
                    </div>
                </div>

                <div class="legal-note">
                    تم تحرير هذا العقد إلكترونياً، ويعد توقيع الأطراف وختم المكتب إقراراً بصحة البيانات والمبالغ المذكورة أعلاه.
                </div>
            </footer>
        </section>
    </main>
</body>
</html>
