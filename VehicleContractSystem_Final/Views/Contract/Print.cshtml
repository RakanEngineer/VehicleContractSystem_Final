@model VehicleContractSystem_Final.Models.Contract
@{
    ViewData["Title"] = "طباعة العقد";
    Layout = null;
    var qrCodeBase64 = ViewBag.QRCodeBase64 as string;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @Model.ContractNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <style>
        body {
            font-family: Arial, Tahoma, sans-serif;
            background: #fff;
            color: #111;
        }

        .print-page {
            max-width: 900px;
            margin: 24px auto;
            padding: 24px;
        }

        .section-title {
            border-bottom: 1px solid #ddd;
            font-weight: 700;
            margin: 24px 0 12px;
            padding-bottom: 8px;
        }

        .info-table th {
            width: 180px;
            color: #555;
        }

        @@media print {
            .no-print {
                display: none;
            }

            .print-page {
                margin: 0;
                max-width: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <main class="print-page">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1 class="h3 mb-2">عقد بيع وشراء مركبة</h1>
                <div>رقم العقد: <strong>@Model.ContractNumber</strong></div>
                <div>تاريخ العقد: @Model.ContractDate.ToString("yyyy-MM-dd")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(qrCodeBase64))
            {
                <img src="data:image/png;base64,@qrCodeBase64" alt="رمز التحقق" width="110" height="110" />
            }
        </div>

        <div class="section-title">بيانات المكتب</div>
        <table class="table table-sm info-table">
            <tr>
                <th>اسم المكتب</th>
                <td>@Model.Office?.Name</td>
            </tr>
            <tr>
                <th>رقم الإجازة</th>
                <td>@Model.Office?.LicenseNumber</td>
            </tr>
            <tr>
                <th>العنوان</th>
                <td>@Model.Office?.Address</td>
            </tr>
        </table>

        <div class="section-title">بيانات البائع</div>
        <table class="table table-sm info-table">
            <tr>
                <th>الاسم</th>
                <td>@Model.SellerName</td>
            </tr>
            <tr>
                <th>رقم الهاتف</th>
                <td>@Model.SellerPhone</td>
            </tr>
            <tr>
                <th>رقم الهوية</th>
                <td>@Model.SellerIdNumber</td>
            </tr>
            <tr>
                <th>العنوان</th>
                <td>@Model.SellerAddress</td>
            </tr>
        </table>

        <div class="section-title">بيانات المشتري</div>
        <table class="table table-sm info-table">
            <tr>
                <th>الاسم</th>
                <td>@Model.BuyerName</td>
            </tr>
            <tr>
                <th>رقم الهاتف</th>
                <td>@Model.BuyerPhone</td>
            </tr>
            <tr>
                <th>رقم الهوية</th>
                <td>@Model.BuyerIdNumber</td>
            </tr>
            <tr>
                <th>العنوان</th>
                <td>@Model.BuyerAddress</td>
            </tr>
        </table>

        <div class="section-title">بيانات المركبة</div>
        <table class="table table-sm info-table">
            <tr>
                <th>المالك الحالي</th>
                <td>@Model.CurrentOwnerName</td>
            </tr>
            <tr>
                <th>الماركة</th>
                <td>@Model.VehicleBrand</td>
            </tr>
            <tr>
                <th>الموديل</th>
                <td>@Model.VehicleModel</td>
            </tr>
            <tr>
                <th>سنة الصنع</th>
                <td>@Model.ManufactureYear</td>
            </tr>
            <tr>
                <th>اللون</th>
                <td>@Model.VehicleColor</td>
            </tr>
            <tr>
                <th>رقم المركبة</th>
                <td>@Model.LicenseNumber</td>
            </tr>
            <tr>
                <th>رقم الشاصي</th>
                <td>@Model.ChassisNumber</td>
            </tr>
        </table>

        <div class="section-title">المعلومات المالية</div>
        <table class="table table-sm info-table">
            <tr>
                <th>سعر المركبة</th>
                <td>@Model.VehiclePrice.ToString("N0")</td>
            </tr>
            <tr>
                <th>المبلغ المدفوع</th>
                <td>@Model.PaidAmount.ToString("N0")</td>
            </tr>
            <tr>
                <th>المبلغ المتبقي</th>
                <td>@Model.RemainingAmount.ToString("N0")</td>
            </tr>
        </table>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="section-title">الملاحظات</div>
            <p>@Model.Notes</p>
        }

        <div class="row mt-5 text-center">
            <div class="col">
                <div class="border-top pt-2">توقيع البائع</div>
            </div>
            <div class="col">
                <div class="border-top pt-2">توقيع المشتري</div>
            </div>
            <div class="col">
                <div class="border-top pt-2">ختم المكتب</div>
            </div>
        </div>

        <div class="mt-4 no-print">
            <button type="button" class="btn btn-primary" onclick="window.print()">طباعة</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">رجوع</a>
        </div>
    </main>
</body>
</html>
