@model VehicleContractSystem_Final.Models.Contract
@{
    ViewData["Title"] = "حذف العقد";
}

<div class="container-fluid" dir="rtl">
    <div class="row mb-4">
        <div class="col">
            <h2 class="text-danger"><i class="bi bi-trash"></i> حذف العقد</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Contract" asp-action="Index">العقود</a></li>
                    <li class="breadcrumb-item active">حذف</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                <div>
                    <h4 class="alert-heading">تأكيد الحذف</h4>
                    <p class="mb-0">يرجى التأكد قبل متابعة الحذف</p>
                </div>
            </div>

            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> تفاصيل العقد</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="30%">رقم العقد:</th>
                            <td><strong class="text-danger">@Model.ContractNumber</strong></td>
                        </tr>
                        <tr>
                            <th>تاريخ العقد:</th>
                            <td>@Model.ContractDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                        <tr>
                            <th>البائع:</th>
                            <td>@Model.SellerName</td>
                        </tr>
                        <tr>
                            <th>المشتري:</th>
                            <td>@Model.BuyerName</td>
                        </tr>
                        <tr>
                            <th>المركبة:</th>
                            <td>@Model.VehicleBrand @Model.VehicleModel - @Model.LicenseNumber</td>
                        </tr>
                        <tr>
                            <th>سعر المركبة:</th>
                            <td><strong>@Model.VehiclePrice.ToString("N0")</strong></td>
                        </tr>
                        <tr>
                            <th>الحالة:</th>
                            <td>
                                <span class="badge @(Model.Status == VehicleContractSystem_Final.Enums.ContractStatus.Open ? "bg-success" : "bg-secondary")">
                                    @(Model.Status == VehicleContractSystem_Final.Enums.ContractStatus.Open ? "مفتوح" : "مغلق")
                                </span>
                            </td>
                        </tr>
                    </table>

                    @if (Model.Payments.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-circle"></i>
                            <strong>تحذير:</strong> هذا العقد يحتوي على دفعات (@Model.Payments.Count الدفعات)
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-3 border-info">
                <div class="card-body">
                    <h6 class="card-title text-info"><i class="bi bi-info-circle"></i> ملاحظة مهمة</h6>
                    <ul class="mb-0">
                        <li>سيتم الحذف بشكل نهائي</li>
                        <li>احذف السجلات المرتبطة أولاً</li>
                        <li>لا يمكن التراجع عن هذا الإجراء</li>
                    </ul>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('هل أنت متأكد من الحذف؟')">
                        <i class="bi bi-trash"></i> تأكيد الحذف
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

