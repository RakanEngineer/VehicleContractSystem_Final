@model VehicleContractSystem_Final.Models.Contract
@{
    ViewData["Title"] = "التفاصيل";
    var vehicleTypeName = string.IsNullOrWhiteSpace(Model.VehicleTypeNameSnapshot) ? Model.VehicleCategory : Model.VehicleTypeNameSnapshot;
    var vehicleModelName = string.IsNullOrWhiteSpace(Model.VehicleModelNameSnapshot) ? Model.VehicleModel : Model.VehicleModelNameSnapshot;
    var vehicleColorName = string.IsNullOrWhiteSpace(Model.VehicleColorNameSnapshot) ? Model.VehicleColor : Model.VehicleColorNameSnapshot;
    var licenseNumber = string.IsNullOrWhiteSpace(Model.LicenseNumberSnapshot) ? Model.LicenseNumber : Model.LicenseNumberSnapshot;
    var chassisNumber = string.IsNullOrWhiteSpace(Model.ChassisNumberSnapshot) ? Model.ChassisNumber : Model.ChassisNumberSnapshot;
    var manufactureYear = Model.ManufactureYearSnapshot ?? Model.ManufactureYear;
    var isOpen = Model.Status == VehicleContractSystem_Final.Enums.ContractStatus.Open;
    var canAddPayment = isOpen && Model.RemainingAmount > 0;
    var canCloseContract = isOpen
        && Model.RemainingAmount <= 0
        && (ViewBag.CanCloseContract as bool? == true);
    var canShowCloseBlockedMessage = isOpen
        && Model.RemainingAmount > 0
        && (ViewBag.CanCloseContract as bool? == true);
}

<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        .payment-receipts,
        .payment-receipts * {
            visibility: visible;
        }

        .payment-receipts {
            position: absolute;
            inset: 0;
            padding: 20mm;
            direction: rtl;
        }

        .no-print {
            display: none !important;
        }

        .payment-receipt {
            break-inside: avoid;
            page-break-inside: avoid;
        }
    }
</style>

<div class="container-fluid" dir="rtl">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-file-earmark-text"></i> تفاصيل العقد</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Contract" asp-action="Index">العقود</a></li>
                    <li class="breadcrumb-item active">@Model.ContractNumber</li>
                </ol>
            </nav>
        </div>
        <div class="col-auto">
            <div class="btn-group">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> تعديل
                </a>
                <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-primary" target="_blank">
                    <i class="bi bi-printer"></i> طباعة
                </a>
                @if (canAddPayment)
                {
                    <a asp-controller="Payment" asp-action="Add" asp-route-contractId="@Model.Id" class="btn btn-success">
                        <i class="bi bi-cash-coin"></i> إضافة دفعة
                    </a>
                }
                @if (canCloseContract)
                {
                    <form asp-action="Close"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('هل أنت متأكد من إغلاق هذا العقد؟ بعد الإغلاق لن يمكن تعديل البيانات القانونية أو إضافة دفعات جديدة.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-lock"></i> إغلاق العقد
                        </button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> العودة للقائمة
                </a>
            </div>
        </div>
    </div>

    <!-- Contract Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="mb-0">@Model.ContractNumber</h4>
                            <small>@Model.ContractDate.ToString("yyyy-MM-dd")</small>
                        </div>
                        <div class="col-auto">
                            <span class="badge @(isOpen ? "bg-success" : "bg-secondary") fs-6">
                                @(isOpen ? "مفتوح" : "مغلق")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Seller Info -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-person"></i> بيانات البائع</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">الاسم:</th>
                            <td>@Model.SellerName</td>
                        </tr>
                        <tr>
                            <th>الهاتف:</th>
                            <td><a href="tel:@Model.SellerPhone">@Model.SellerPhone</a></td>
                        </tr>
                        <tr>
                            <th>رقم الهوية:</th>
                            <td>@Model.SellerIdNumber</td>
                        </tr>
                        <tr>
                            <th>العنوان:</th>
                            <td>@Model.SellerAddress</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Buyer Info -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-person-check"></i> بيانات المشتري</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">الاسم:</th>
                            <td>@Model.BuyerName</td>
                        </tr>
                        <tr>
                            <th>الهاتف:</th>
                            <td><a href="tel:@Model.BuyerPhone">@Model.BuyerPhone</a></td>
                        </tr>
                        <tr>
                            <th>رقم الهوية:</th>
                            <td>@Model.BuyerIdNumber</td>
                        </tr>
                        <tr>
                            <th>العنوان:</th>
                            <td>@Model.BuyerAddress</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Vehicle Info -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-car-front"></i> بيانات المركبة</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <strong>الماركة:</strong><br />
                            @Model.VehicleBrand
                        </div>
                        <div class="col-md-3">
                            <strong>موديل المركبة:</strong><br />
                            @vehicleModelName
                        </div>
                        <div class="col-md-3">
                            <strong>اللون:</strong><br />
                            @vehicleColorName
                        </div>
                        <div class="col-md-3">
                            <strong>سنة الصنع:</strong><br />
                            @manufactureYear
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-4">
                            <strong>صنف المركبة:</strong><br />
                            @vehicleTypeName
                        </div>
                        <div class="col-md-4">
                            <strong>رقم اللوحة:</strong><br />
                            <span class="fs-5 text-primary">@licenseNumber</span>
                        </div>
                        <div class="col-md-4">
                            <strong>رقم الشاصي:</strong><br />
                            <span class="fs-6">@chassisNumber</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Info -->
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card border-warning">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="bi bi-cash-stack"></i> المعلومات المالية</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>سعر المركبة:</span>
                        <strong class="fs-5">@Model.VehiclePrice.ToString("N0")</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>المبلغ المدفوع:</span>
                        <strong class="fs-5 text-success">@Model.PaidAmount.ToString("N0")</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span>المبلغ المتبقي:</span>
                        <strong class="fs-4 text-danger">@Model.RemainingAmount.ToString("N0")</strong>
                    </div>
                    @if (canShowCloseBlockedMessage)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            لا يمكن إغلاق العقد قبل تسديد كامل المبلغ المتبقي.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Address -->
        <div class="col-lg-8 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-geo-alt"></i> تفاصيل العنوان</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <strong>المحافظة:</strong><br />
                            @Model.Province?.NameAr
                        </div>
                        <div class="col-md-3">
                            <strong>المدينة:</strong><br />
                            @Model.City?.NameAr
                        </div>
                        <div class="col-md-2">
                            <strong>المحلة:</strong><br />
                            @Model.Neighborhood
                        </div>
                        <div class="col-md-2">
                            <strong>رقم الزقاق:</strong><br />
                            @Model.AlleyNumber
                        </div>
                        <div class="col-md-2">
                            <strong>رقم الدار:</strong><br />
                            @Model.HouseNumber
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notes -->
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-sticky"></i> الملاحظات</h5>
                    </div>
                    <div class="card-body">
                        @Model.Notes
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Payments -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-wallet2"></i> جدول الدفعات</h5>
                </div>
                <div class="card-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>المبلغ</th>
                                <th>طريقة الدفع</th>
                                <th>الملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Payments.Any())
                            {
                                @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                        <td><strong>@payment.Amount.ToString("N0")</strong></td>
                                        <td>@payment.PaymentMethod</td>
                                        <td>@payment.Notes</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">لا توجد دفعات مسجلة لهذا العقد</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <th>إجمالي المدفوع</th>
                                <th colspan="3"><strong>@Model.PaidAmount.ToString("N0")</strong></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Payments.Any())
    {
        <div class="row payment-receipts">
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-receipt"></i> إيصالات الدفعات</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm no-print" onclick="window.print()">
                            <i class="bi bi-printer"></i> طباعة الإيصالات
                        </button>
                    </div>
                    <div class="card-body">
                        @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                        {
                            <div class="payment-receipt border rounded p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="mb-1">إيصال دفعة</h5>
                                        <div class="text-muted">رقم العقد: @Model.ContractNumber</div>
                                    </div>
                                    <div class="text-end">
                                        <div>تاريخ الدفعة</div>
                                        <strong>@payment.PaymentDate.ToString("yyyy-MM-dd")</strong>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <span class="text-muted">المبلغ</span><br />
                                        <strong class="fs-5">@payment.Amount.ToString("N0") دينار</strong>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <span class="text-muted">طريقة الدفع</span><br />
                                        <strong>@payment.PaymentMethod</strong>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <span class="text-muted">الملاحظات</span><br />
                                        <strong>@payment.Notes</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Audit Info -->
    <div class="row">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body">
                    <small class="text-muted">
                        <i class="bi bi-clock-history"></i> تاريخ الإنشاء: @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") |
                        <i class="bi bi-person"></i> أنشئ بواسطة: @Model.CreatedByUser?.FullName
                    </small>
                </div>
            </div>
        </div>
    </div>

</div>
