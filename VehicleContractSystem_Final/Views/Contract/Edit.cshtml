@model VehicleContractSystem_Final.Models.ViewModel.ContractViewModel
@{
    ViewData["Title"] = "تعديل العقد";
    var isClosed = Model.Contract.Status == VehicleContractSystem_Final.Enums.ContractStatus.Closed;
    var vehicleTypeName = string.IsNullOrWhiteSpace(Model.Contract.VehicleTypeNameSnapshot) ? Model.Contract.VehicleCategory : Model.Contract.VehicleTypeNameSnapshot;
    var vehicleModelName = string.IsNullOrWhiteSpace(Model.Contract.VehicleModelNameSnapshot) ? Model.Contract.VehicleModel : Model.Contract.VehicleModelNameSnapshot;
    var vehicleColorName = string.IsNullOrWhiteSpace(Model.Contract.VehicleColorNameSnapshot) ? Model.Contract.VehicleColor : Model.Contract.VehicleColorNameSnapshot;
    var licenseNumber = string.IsNullOrWhiteSpace(Model.Contract.LicenseNumberSnapshot) ? Model.Contract.LicenseNumber : Model.Contract.LicenseNumberSnapshot;
    var chassisNumber = string.IsNullOrWhiteSpace(Model.Contract.ChassisNumberSnapshot) ? Model.Contract.ChassisNumber : Model.Contract.ChassisNumberSnapshot;
    var manufactureYear = Model.Contract.ManufactureYearSnapshot ?? Model.Contract.ManufactureYear;
    var vehicleProvinceName = Model.Provinces.FirstOrDefault(p => p.Id == Model.Contract.ProvinceId)?.NameAr;
    vehicleProvinceName = vehicleProvinceName == "كربلاء" ? "كربلاء المقدسة" : vehicleProvinceName;
    vehicleProvinceName = vehicleProvinceName == "النجف" ? "النجف الأشرف" : vehicleProvinceName;
}

<div class="container-fluid" dir="rtl">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-pencil-square"></i> تعديل العقد</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Contract" asp-action="Index">العقود</a></li>
                    <li class="breadcrumb-item active">تعديل</li>
                </ol>
            </nav>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Contract.Id" />
        <input type="hidden" asp-for="Contract.ContractNumber" />

        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> رقم العقد: <strong>@Model.Contract.ContractNumber</strong>
        </div>
        @if (isClosed)
        {
            <div class="alert alert-warning">
                <i class="bi bi-lock"></i> هذا العقد مغلق، لذلك تظهر البيانات للقراءة فقط ولا يمكن تعديل بياناته القانونية.
            </div>
        }

        <!-- Copy the same structure as Create.cshtml but with edit-specific elements -->
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-person"></i> بيانات البائع</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Contract.SellerName" class="form-label"></label>
                            <input asp-for="Contract.SellerName" class="form-control" readonly="@isClosed" />
                            <span asp-validation-for="Contract.SellerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contract.SellerPhone" class="form-label"></label>
                            <input asp-for="Contract.SellerPhone" class="form-control" readonly="@isClosed" />
                            <span asp-validation-for="Contract.SellerPhone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contract.SellerIdNumber" class="form-label"></label>
                            <input asp-for="Contract.SellerIdNumber" class="form-control" readonly="@isClosed" />
                            <span asp-validation-for="Contract.SellerIdNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contract.SellerAddress" class="form-label"></label>
                            <textarea asp-for="Contract.SellerAddress" class="form-control" rows="2" readonly="@isClosed"></textarea>
                            <span asp-validation-for="Contract.SellerAddress" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-person-check"></i> بيانات المشتري</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Contract.BuyerName" class="form-label"></label>
                            <input asp-for="Contract.BuyerName" class="form-control" readonly="@isClosed" />
                            <span asp-validation-for="Contract.BuyerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contract.BuyerPhone" class="form-label"></label>
                            <input asp-for="Contract.BuyerPhone" class="form-control" readonly="@isClosed" />
                            <span asp-validation-for="Contract.BuyerPhone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contract.BuyerIdNumber" class="form-label"></label>
                            <input asp-for="Contract.BuyerIdNumber" class="form-control" readonly="@isClosed" />
                            <span asp-validation-for="Contract.BuyerIdNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contract.BuyerAddress" class="form-label"></label>
                            <textarea asp-for="Contract.BuyerAddress" class="form-control" rows="2" readonly="@isClosed"></textarea>
                            <span asp-validation-for="Contract.BuyerAddress" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-car-front"></i> بيانات المركبة</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-light border mb-3">
                            <i class="bi bi-shield-lock"></i> بيانات المركبة القانونية محفوظة من وقت إنشاء العقد وتظهر هنا للقراءة فقط.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">اسم المالك</div>
                                    <strong>@Model.Contract.CurrentOwnerName</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">عنوان المالك</div>
                                    <strong>@Model.Contract.CurrentOwnerAddress</strong>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">الماركة</div>
                                    <strong>@Model.Contract.VehicleBrand</strong>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">صنف المركبة</div>
                                    <strong>@vehicleTypeName</strong>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">نوع المركبة</div>
                                    <strong>@vehicleModelName</strong>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">اللون</div>
                                    <strong>@vehicleColorName</strong>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">سنة الصنع</div>
                                    <strong>@manufactureYear</strong>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">رقم السنوية</div>
                                    <strong>@Model.Contract.AnnualRegistrationNumber</strong>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">محافظة المركبة</div>
                                    <strong>@vehicleProvinceName</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">رقم المركبة</div>
                                    <strong>@licenseNumber</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-2 h-100">
                                    <div class="text-muted small">رقم الشاصي</div>
                                    <strong>@chassisNumber</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-cash-stack"></i> المعلومات المالية</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Contract.VehiclePrice" class="form-label"></label>
                            <input asp-for="Contract.VehiclePrice"
                                   class="form-control"
                                   type="number"
                                   step="100"
                                   min="0"
                                   placeholder="أدخل سعر المركبة بالدولار"
                                   id="vehiclePrice"
                                   readonly="@isClosed" />
                            <span asp-validation-for="Contract.VehiclePrice" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">استلم البائع مبلغ وقدره</label>
                            <input class="form-control bg-light"
                                   type="number"
                                   step="100"
                                   min="0"
                                   placeholder="أدخل المبلغ المستلم بالدولار"
                                   value="@Model.Contract.PaidAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">المبلغ المتبقي</label>
                            <input type="text" class="form-control bg-light" id="remainingAmount" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contract.Status" class="form-label"></label>
                            <input class="form-control bg-light" value="@(isClosed ? "مغلق" : "مفتوح")" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-body">
                        <label asp-for="Contract.Notes" class="form-label"></label>
                        <textarea asp-for="Contract.Notes" class="form-control" rows="3" readonly="@isClosed"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="d-flex gap-2">
                    @if (!isClosed)
                    {
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-save"></i> حفظ التغييرات
                        </button>
                    }
                    <a asp-action="Details" asp-route-id="@Model.Contract.Id" class="btn btn-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> @(isClosed ? "العودة للتفاصيل" : "إلغاء")
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            function calculateRemaining() {
                var price = parseFloat($('#vehiclePrice').val()) || 0;
                var paid = @Model.Contract.PaidAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                var remaining = Math.max(price - paid, 0);
                $('#remainingAmount').val(remaining.toFixed(2));
            }

            $('#vehiclePrice').on('input', calculateRemaining);
            calculateRemaining();

        });
    </script>
}
