@{
    ViewData["Title"] = "يتطلب تسجيل الدخول";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div dir="rtl" class="mx-auto" style="max-width: 760px;">
    <section class="border rounded p-4 p-md-5 bg-white text-center">
        <i class="bi bi-shield-lock text-primary" style="font-size: 4rem;" aria-hidden="true"></i>
        <h1 class="h3 mt-3">هذه الصفحة مخصصة للمستخدمين المعتمدين</h1>
        <p class="text-secondary mt-3">
            محتوى النظام الداخلي محمي، ويلزم تسجيل الدخول بحساب معتمد للوصول إليه.
            لا تدخل بياناتك إلا في صفحة الدخول الرسمية على هذا النطاق.
        </p>

        <div class="alert alert-light border text-start mt-4" role="note">
            <i class="bi bi-info-circle text-success"></i>
            الموقع لا يطلب بيانات بطاقات مصرفية، ولا يطلب تنزيل أو تثبيت أي برامج.
        </div>

        <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right"></i> الانتقال إلى تسجيل الدخول
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> العودة إلى الرئيسية
            </a>
        </div>
    </section>
</div>
