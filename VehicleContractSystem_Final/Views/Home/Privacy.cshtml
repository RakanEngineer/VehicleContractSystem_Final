@* @{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1> *@

<p>Use this page to detail your site's privacy policy.</p>

@{
    ViewData["Title"] = "الخصوصية";
}

<div class="container" dir="rtl">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="bi bi-shield-check"></i> سياسة الخصوصية</h1>
            <p class="text-muted">آخر تحديث: @DateTime.Now.ToString("yyyy-MM-dd")</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">مقدمة</h4>
                    <p class="card-text">
                        توضح هذه الصفحة كيفية التعامل مع بيانات النظام
                    </p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-clipboard-data"></i> جمع البيانات</h4>
                    <p>نجمع البيانات اللازمة لإدارة العقود فقط</p>
                    <ul>
                        <li>المعلومات الشخصية</li>
                        <li>معلومات الاتصال</li>
                        <li>بيانات العقد</li>
                        <li>بيانات المركبة</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-lock"></i> حماية البيانات</h4>
                    <p>يتم حماية البيانات وفق صلاحيات المستخدمين</p>
                    <ul>
                        <li>يتم استخدام الحماية المناسبة للبيانات</li>
                        <li>خوادم آمنة</li>
                        <li>التحكم بالوصول</li>
                        <li>يتم أخذ نسخ احتياطية دورية</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-people"></i> مشاركة البيانات</h4>
                    <p>لا تتم مشاركة البيانات إلا عند الحاجة القانونية أو التشغيلية</p>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        لا توجد مشاركة مع أطراف ثالثة
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-person-check"></i> حقوقك</h4>
                    <p>يمكنك طلب مراجعة أو تصحيح البيانات وفق الصلاحيات المتاحة</p>
                    <ul>
                        <li>حق الوصول</li>
                        <li>حق التصحيح</li>
                        <li>حق الحذف</li>
                        <li>حق التصدير</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-cookie"></i> ملفات الارتباط</h4>
                    <p>نستخدم ملفات الارتباط اللازمة لتشغيل النظام</p>
                </div>
            </div>

            <div class="card mb-4 border-warning">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-envelope"></i> تواصل معنا</h4>
                    <p>للاستفسار حول الخصوصية يرجى التواصل مع إدارة النظام</p>
                    <p>
                        <strong>البريد الإلكتروني:</strong> privacy@vehiclecontract.com<br />
                        <strong>الهاتف:</strong> 07701234567
                    </p>
                </div>
            </div>

            <div class="text-center mt-4 mb-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> العودة للرئيسية
                </a>
            </div>
        </div>
    </div>
</div>


