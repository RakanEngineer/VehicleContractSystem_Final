}
<h1>@ViewData["Title"]</h1> *@

<p class="visually-hidden">سياسة الخصوصية لنظام إدارة عقود المركبات</p>

@{
    ViewData["Title"] = "سياسة الخصوصية";
}

<div class="container" dir="rtl">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="bi bi-shield-check"></i> سياسة الخصوصية</h1>
            <p class="text-muted">معلومات التعامل مع البيانات داخل نظام إدارة عقود المركبات</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">مقدمة</h4>
                    <p class="card-text">
                        توضح هذه الصفحة كيفية التعامل مع بيانات النظام
                    </p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-clipboard-data"></i> جمع البيانات</h4>
                    <p>نجمع البيانات اللازمة لإدارة العقود فقط</p>
                    <ul>
                        <li>المعلومات الشخصية</li>
                        <li>معلومات الاتصال</li>
                        <li>بيانات العقد</li>
                        <li>بيانات المركبة</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-lock"></i> حماية البيانات</h4>
                    <p>يتم تقييد الوصول إلى البيانات وفق حساب المستخدم ودوره والمكتب المرتبط به</p>
                    <ul>
                        <li>المصادقة مطلوبة للوصول إلى وظائف النظام الداخلية</li>
                        <li>الصلاحيات تحدد العمليات والبيانات المتاحة لكل مستخدم</li>
                        <li>يجب عدم مشاركة كلمة المرور أو رمز استعادة الحساب</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-people"></i> مشاركة البيانات</h4>
                    <p>تتم معالجة البيانات للأغراض التشغيلية والقانونية المرتبطة بإدارة العقود والخدمات المساندة.</p>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        لا يطلب الموقع بيانات بطاقات مصرفية ولا يطلب تنزيل أو تثبيت برامج.
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-person-check"></i> حقوقك</h4>
                    <p>يمكن طلب مراجعة البيانات أو تصحيحها من إدارة المكتب التي أنشأت الحساب أو اعتمدته.</p>
                    <ul>
                        <li>مراجعة بيانات الحساب</li>
                        <li>طلب تصحيح البيانات غير الدقيقة</li>
                        <li>الاستفسار عن صلاحيات الوصول</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-cookie"></i> ملفات الارتباط</h4>
                    <p>نستخدم ملفات الارتباط اللازمة لتشغيل النظام</p>
                </div>
            </div>

            <div class="card mb-4 border-warning">
                <div class="card-body">
                    <h4 class="card-title"><i class="bi bi-envelope"></i> تواصل معنا</h4>
                    <p>للاستفسار حول الخصوصية، يرجى التواصل مع إدارة المكتب التي منحتك الحساب.</p>
                </div>
            </div>

            <div class="text-center mt-4 mb-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> العودة للرئيسية
                </a>
            </div>
        </div>
    </div>
</div>


