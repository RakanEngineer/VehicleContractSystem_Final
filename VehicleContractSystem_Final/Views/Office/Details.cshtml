@model VehicleContractSystem_Final.Models.Office
@inject IStringLocalizer<VehicleContractSystem_Final.Resources.SharedResources> Localizer
@{
    ViewData["Title"] = Model.Name;
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="container-fluid" dir=@(isRtl ? "rtl" : "ltr")>
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-building"></i> @Model.Name</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Office" asp-action="Index">@Localizer["Offices"]</a></li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>
        </div>
        <div class="col-auto">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> @Localizer["Edit"]
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> @Localizer["BackToList"]
            </a>
        </div>
    </div>

    <!-- Office Info -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> @Localizer["OfficeInformation"]</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="30%">@Localizer["Name"]:</th>
                            <td><strong>@Model.Name</strong></td>
                        </tr>
                        <tr>
                            <th>@Localizer["LicenseNumber"]:</th>
                            <td>@Model.LicenseNumber</td>
                        </tr>
                        <tr>
                            <th>@Localizer["Address"]:</th>
                            <td>@Model.Address</td>
                        </tr>
                        <tr>
                            <th>@Localizer["Phone"]:</th>
                            <td><a href="tel:@Model.Phone">@Model.Phone</a></td>
                        </tr>
                        <tr>
                            <th>@Localizer["Email"]:</th>
                            <td><a href="mailto:@Model.Email">@Model.Email</a></td>
                        </tr>
                        <tr>
                            <th>@Localizer["EstablishedDate"]:</th>
                            <td>@Model.EstablishedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                        <tr>
                            <th>@Localizer["Status"]:</th>
                            <td>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                    @(Model.IsActive? Localizer["Active"] : Localizer["Inactive"])
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-bar-chart"></i> @Localizer["Statistics"]</h5>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="display-4 text-primary">@Model.Staff.Count</div>
                        <small class="text-muted">@Localizer["Staff"]</small>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <div class="display-4 text-success">@Model.Contracts.Count</div>
                        <small class="text-muted">@Localizer["Contracts"]</small>
                    </div>
                    <hr />
                    <div>
                        <div class="display-4 text-info">@Model.Contracts.Count(c => c.Status == VehicleContractSystem_Final.Enums.ContractStatus.Open)</div>
                        <small class="text-muted">@Localizer["OpenContracts"]</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Staff -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-people"></i> @Localizer["Staff"] (@Model.Staff.Count)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Staff.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Name"]</th>
                                        <th>@Localizer["Email"]</th>
                                        <th>@Localizer["Phone"]</th>
                                        <th>@Localizer["Role"]</th>
                                        <th>@Localizer["Status"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var staff in Model.Staff)
                                    {
                                        <tr>
                                            <td>@staff.FullName</td>
                                            <td>@staff.Email</td>
                                            <td>@staff.PhoneNumber</td>
                                            <td>
                                                <span class="badge bg-info">@Localizer["User"]</span>
                                            </td>
                                            <td>
                                                <span class="badge @(staff.IsApproved ? "bg-success" : "bg-warning")">
                                                    @(staff.IsApproved? Localizer["Approved"] : Localizer["Pending"])
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-3">@Localizer["NoStaff"]</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Contracts -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> @Localizer["RecentContracts"]</h5>
                </div>
                <div class="card-body">
                    @if (Model.Contracts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>@Localizer["ContractNumber"]</th>
                                        <th>@Localizer["Seller"]</th>
                                        <th>@Localizer["Buyer"]</th>
                                        <th>@Localizer["Date"]</th>
                                        <th>@Localizer["Amount"]</th>
                                        <th>@Localizer["Status"]</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contract in Model.Contracts.OrderByDescending(c => c.CreatedAt).Take(10))
                                    {
                                        <tr>
                                            <td><strong>@contract.ContractNumber</strong></td>
                                            <td>@contract.SellerName</td>
                                            <td>@contract.BuyerName</td>
                                            <td>@contract.ContractDate.ToString("yyyy-MM-dd")</td>
                                            <td>@contract.VehiclePrice.ToString("N0")</td>
                                            <td>
                                                <span class="badge @(contract.Status == VehicleContractSystem_Final.Enums.ContractStatus.Open ? "bg-success" : "bg-secondary")">
                                                    @Localizer[contract.Status.ToString()]
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-controller="Contract" asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-info">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-3">@Localizer["NoContracts"]</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
