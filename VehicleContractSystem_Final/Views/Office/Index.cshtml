@model List<VehicleContractSystem_Final.Models.Office>
@{
    ViewData["Title"] = "المكاتب";
}

<div class="container-fluid" dir="rtl">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-building"></i> المكاتب</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> إنشاء جديد
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-building" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3">لا توجد مكاتب</h4>
                <p class="text-muted">لم يتم إنشاء مكاتب بعد</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> إنشاء أول مكتب
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var office in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 @(office.IsActive ? "" : "border-secondary")">
                        <div class="card-header @(office.IsActive ? "bg-primary text-white" : "bg-secondary text-white")">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@office.Name</h5>
                                @if (!office.IsActive)
                                {
                                    <span class="badge bg-danger">غير نشط</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <i class="bi bi-card-text text-muted"></i>
                                <small><strong>رقم اللوحة:</strong> @office.LicenseNumber</small>
                            </div>

                            <div class="mb-2">
                                <i class="bi bi-geo-alt text-muted"></i>
                                <small>@office.Address</small>
                            </div>

                            <div class="mb-2">
                                <i class="bi bi-telephone text-muted"></i>
                                <small><a href="tel:@office.Phone">@office.Phone</a></small>
                            </div>

                            <div class="mb-2">
                                <i class="bi bi-envelope text-muted"></i>
                                <small><a href="mailto:@office.Email">@office.Email</a></small>
                            </div>

                            <hr />

                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="fs-4 fw-bold text-primary">@office.Staff.Count</div>
                                    <small class="text-muted">الموظفون</small>
                                </div>
                                <div class="col-6">
                                    <div class="fs-4 fw-bold text-success">@office.Contracts.Count</div>
                                    <small class="text-muted">العقود</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@office.Id" class="btn btn-sm btn-info flex-fill">
                                    <i class="bi bi-eye"></i> التفاصيل
                                </a>
                                <a asp-action="Edit" asp-route-id="@office.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

